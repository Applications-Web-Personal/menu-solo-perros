---
import { contact, whatsappLink } from "../data/menu";
---

<section
  id="inicio"
  class="relative min-h-[85vh] flex items-center justify-center overflow-hidden bg-[#060d1e]"
>
  <!-- Imagen de fondo con overlay dramático -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1614396379908-38b11c4c8804?w=1600&h=900&fit=crop&crop=center"
      alt="Hot dogs y hamburguesas Solo Perros"
      class="w-full h-full object-cover opacity-20"
    />
    <!-- Overlay multicapa: azul oscuro + viñeta roja abajo -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#060d1e]/90 via-[#0d1b3e]/50 to-[#060d1e]"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#E31E24]/10 via-transparent to-transparent"></div>
  </div>

  <!-- Contenido -->
  <div class="relative z-10 text-center px-4 py-20 max-w-4xl mx-auto">
    <!-- Logo grande con glow -->
    <div class="mx-auto mb-8 w-fit">
      <img
        src={`${import.meta.env.BASE_URL}/images/logo.png`}
        alt="Solo Perros"
        class="w-36 h-36 sm:w-48 sm:h-48 object-contain drop-shadow-2xl transition-transform duration-700 hover:scale-105"
        style="filter: drop-shadow(0 0 24px rgba(227,30,36,0.45)) drop-shadow(0 0 48px rgba(227,30,36,0.15))"
      />
    </div>

    <!-- Nombre -->
    <h1 class="font-display text-7xl sm:text-9xl text-white tracking-widest text-shadow-glow mb-1 leading-none">
      SOLO PERROS
    </h1>

    <!-- Subtítulo con badge -->
    <div class="flex items-center justify-center gap-3 mb-5">
      <div class="h-px flex-1 max-w-16 bg-gradient-to-r from-transparent to-[#E31E24]/60"></div>
      <p class="font-sub font-bold text-[#F5A623] text-lg sm:text-xl tracking-[0.3em] uppercase text-shadow-warm">
        Comidas Rápidas
      </p>
      <div class="h-px flex-1 max-w-16 bg-gradient-to-l from-transparent to-[#E31E24]/60"></div>
    </div>

    <!-- Descripción -->
    <p class="text-gray-400 text-base sm:text-lg max-w-xl mx-auto mb-10 leading-relaxed">
      Aquí las papas crujen, las salchichas brillan y las salsas hacen magia.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a
        href={whatsappLink()}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-3 bg-gradient-to-r from-[#25D366] to-[#1aad56] hover:from-[#128C7E] hover:to-[#0e7060] text-white font-bold text-lg px-8 py-4 rounded-2xl transition-all shadow-xl hover:shadow-[0_8px_32px_rgba(37,211,102,0.35)] hover:-translate-y-1 font-sub tracking-wider"
      >
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"></path>
          <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.553 4.116 1.522 5.847L0 24l6.338-1.501A11.95 11.95 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.01-1.373l-.36-.214-3.732.884.944-3.638-.235-.374A9.818 9.818 0 1 1 12 21.818z"></path>
        </svg>
        Pedir a domicilio
      </a>
      <a
        href="#hotdogs"
        class="flex items-center gap-2 border-2 border-[#E31E24] text-white font-bold text-lg px-8 py-4 rounded-2xl hover:bg-[#E31E24]/15 hover:border-[#ff3a40] hover:-translate-y-1 transition-all duration-200 font-sub tracking-wider shadow-[0_0_0_0_rgba(227,30,36,0)] hover:shadow-[0_0_20px_rgba(227,30,36,0.25)]"
      >
        Ver la carta ↓
      </a>
    </div>

    <!-- Datos de contacto quick -->
    <div class="mt-10 flex flex-wrap gap-4 justify-center text-sm text-gray-500">
      <span class="flex items-center gap-1.5 font-sub tracking-wide">
        <svg class="w-4 h-4 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"></path>
        </svg>
        {contact.whatsappDisplay}
      </span>
      <span class="flex items-center gap-1.5 font-sub tracking-wide">
        <svg class="w-4 h-4 text-[#E31E24]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"></path>
        </svg>
        {contact.mapsDisplay}
      </span>
    </div>
  </div>

  <!-- Divider de transición al contenido -->
  <div class="absolute bottom-0 left-0 right-0 divider-brand"></div>
</section>
