---
import { adicionales, adicionalesPago, combos, formatPrice, contact } from "../data/menu";

function comboLabel(id: string) {
  return id.replace("combo-", "").replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
}
---

<div
  id="order-modal"
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-product-name"
  data-whatsapp={contact.whatsapp.replace("+", "")}
>
  <!-- Backdrop -->
  <div id="modal-backdrop" class="absolute inset-0 bg-black/75 backdrop-blur-sm"></div>

  <!-- Panel -->
  <div class="relative bg-[#0D1B3E] border border-[#1B3F8B]/60 rounded-2xl w-full max-w-lg max-h-[92vh] flex flex-col shadow-2xl">

    <!-- Header fijo -->
    <div class="shrink-0 border-b border-[#1B3F8B]/40 px-5 py-4 flex items-start justify-between gap-4">
      <div>
        <p class="text-gray-500 text-xs uppercase tracking-widest mb-1">Personaliza tu pedido</p>
        <h2 id="modal-product-name" class="font-display text-2xl text-white leading-tight"></h2>
        <p id="modal-product-price-base" class="text-[#E31E24] font-bold text-base mt-0.5"></p>
      </div>
      <button
        id="modal-close"
        aria-label="Cerrar"
        class="shrink-0 mt-1 text-gray-400 hover:text-white transition-colors p-1.5 rounded-lg hover:bg-[#1B3F8B]/30"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Cuerpo scrolleable -->
    <div class="overflow-y-auto px-5 py-5 space-y-7 flex-1">

      <!-- Combos -->
      <div>
        <p class="text-[#F5A623] font-bold text-xs uppercase tracking-wider mb-3 flex items-center gap-1.5">
          <span>🍟</span> ¿Lo quieres en combo?
          <span class="text-gray-600 font-normal normal-case tracking-normal">— opcional</span>
        </p>
        <div class="space-y-2">
          <!-- Sin combo (opción por defecto) -->
          <label class="flex items-center gap-3 cursor-pointer group bg-[#1a2340] hover:bg-[#1B3F8B]/20 rounded-xl px-3 py-2.5 border border-[#1B3F8B]/30 hover:border-[#1B3F8B]/60 transition-colors">
            <input
              type="radio"
              name="combo"
              value=""
              checked
              class="w-4 h-4 accent-[#F5A623] cursor-pointer shrink-0"
            />
            <span class="text-gray-400 text-sm group-hover:text-white transition-colors">Sin combo</span>
          </label>
          <!-- Cada combo disponible -->
          {
            combos.map((combo) => (
              <label class="flex items-center justify-between gap-3 cursor-pointer group bg-[#1a2340] hover:bg-[#1B3F8B]/20 rounded-xl px-3 py-2.5 border border-[#1B3F8B]/30 hover:border-[#1B3F8B]/60 transition-colors">
                <div class="flex items-center gap-2.5 min-w-0">
                  <input
                    type="radio"
                    name="combo"
                    value={combo.id}
                    data-price={combo.price}
                    data-label={comboLabel(combo.id)}
                    data-includes={combo.includes.join(", ")}
                    class="w-4 h-4 accent-[#F5A623] cursor-pointer shrink-0"
                  />
                  <div class="min-w-0">
                    <span class="text-gray-300 text-sm group-hover:text-white transition-colors block leading-tight">
                      Combo {comboLabel(combo.id)}
                    </span>
                    <span class="text-gray-600 text-xs leading-tight block">
                      {combo.includes.join(" · ")}
                    </span>
                  </div>
                </div>
                <span class="text-[#F5A623] font-bold text-sm shrink-0">+{formatPrice(combo.price)}</span>
              </label>
            ))
          }
        </div>
      </div>

      <!-- Divisor -->
      <div class="h-px bg-[#1B3F8B]/40"></div>

      <!-- Adicionales gratuitos (solo hot dogs) -->
      <div id="adicionales-gratuitos-section">
        <p class="text-[#F5A623] font-bold text-xs uppercase tracking-wider mb-3 flex items-center gap-1.5">
          <span>⚡</span> Adicionales incluidos
          <span class="text-gray-600 font-normal normal-case tracking-normal">— sin costo</span>
        </p>
        <div class="grid grid-cols-2 gap-y-2 gap-x-4">
          {
            adicionales.map((a) => (
              <label class="flex items-center gap-2.5 cursor-pointer group py-1">
                <input
                  type="checkbox"
                  name="adicional-gratis"
                  value={a}
                  class="w-4 h-4 rounded accent-[#F5A623] cursor-pointer shrink-0"
                />
                <span class="text-gray-300 text-sm group-hover:text-white transition-colors leading-tight">
                  {a}
                </span>
              </label>
            ))
          }
        </div>
        <!-- Divisor inferior de adicionales gratuitos -->
        <div class="mt-7 h-px bg-[#1B3F8B]/40"></div>
      </div>

      <!-- Adicionales con costo -->
      <div>
        <p class="text-[#E31E24] font-bold text-xs uppercase tracking-wider mb-3 flex items-center gap-1.5">
          <span>➕</span> Adicionales extra
          <span class="text-gray-600 font-normal normal-case tracking-normal">— costo adicional</span>
        </p>
        <div class="space-y-2">
          {
            adicionalesPago.map((a) => (
              <label class="flex items-center justify-between gap-3 cursor-pointer group bg-[#1a2340] hover:bg-[#1B3F8B]/20 rounded-xl px-3 py-2.5 border border-[#1B3F8B]/30 hover:border-[#1B3F8B]/60 transition-colors">
                <div class="flex items-center gap-2.5 min-w-0">
                  <input
                    type="checkbox"
                    name="adicional-pago"
                    value={a.name}
                    data-price={a.price}
                    class="w-4 h-4 rounded accent-[#E31E24] cursor-pointer shrink-0"
                  />
                  <div class="min-w-0">
                    <span class="text-gray-300 text-sm group-hover:text-white transition-colors block leading-tight">
                      {a.name}
                    </span>
                    {a.detail && (
                      <span class="text-gray-600 text-xs">{a.detail}</span>
                    )}
                  </div>
                </div>
                <span class="text-[#E31E24] font-bold text-sm shrink-0">+{formatPrice(a.price)}</span>
              </label>
            ))
          }
        </div>
      </div>

      <!-- Divisor -->
      <div class="h-px bg-[#1B3F8B]/40"></div>

      <!-- Observaciones -->
      <div>
        <label
          for="modal-observaciones"
          class="text-gray-400 font-bold text-xs uppercase tracking-wider mb-2 flex items-center gap-1.5"
        >
          <span>📝</span> Observaciones
          <span class="text-gray-600 font-normal normal-case tracking-normal">— opcional</span>
        </label>
        <textarea
          id="modal-observaciones"
          rows="3"
          placeholder="Ej: extra picante, sin cebolla…"
          class="w-full bg-[#1a2340] border border-[#1B3F8B]/40 rounded-xl px-4 py-3 text-gray-300 text-sm placeholder-gray-600 resize-none focus:outline-none focus:border-[#F5A623]/60 transition-colors"
        ></textarea>
      </div>
    </div>

    <!-- Footer fijo con total y botón -->
    <div class="shrink-0 border-t border-[#1B3F8B]/40 px-5 py-4 space-y-3">
      <!-- Total -->
      <div class="flex items-center justify-between px-1">
        <span class="text-gray-400 text-sm font-medium">Total estimado</span>
        <span id="modal-total" class="text-white font-bold text-xl"></span>
      </div>

      <!-- Botones: carrito + directo -->
      <div class="grid grid-cols-2 gap-3">
        <button
          id="modal-add-cart"
          type="button"
          class="flex items-center justify-center gap-2 bg-[#1B3F8B] hover:bg-[#2451a8] active:bg-[#0D1B3E] text-white font-bold py-3.5 rounded-xl transition-colors text-sm border border-[#1B3F8B]"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2 8h14l-2-8M9 21a1 1 0 100-2 1 1 0 000 2zm10 0a1 1 0 100-2 1 1 0 000 2z"/>
          </svg>
          Agregar al carrito
        </button>
        <button
          id="modal-confirm"
          type="button"
          class="flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#128C7E] active:bg-[#075E54] text-white font-bold py-3.5 rounded-xl transition-colors text-sm"
        >
          <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"></path>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.553 4.116 1.522 5.847L0 24l6.338-1.501A11.95 11.95 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.01-1.373l-.36-.214-3.732.884.944-3.638-.235-.374A9.818 9.818 0 1 1 12 21.818z"></path>
          </svg>
          Pedir directo
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { addItem } from "../scripts/cart";

  const modal = document.getElementById("order-modal") as HTMLElement;
  const backdrop = document.getElementById("modal-backdrop") as HTMLElement;
  const closeBtn = document.getElementById("modal-close") as HTMLButtonElement;
  const confirmBtn = document.getElementById("modal-confirm") as HTMLButtonElement;
  const addCartBtn = document.getElementById("modal-add-cart") as HTMLButtonElement;
  const productNameEl = document.getElementById("modal-product-name") as HTMLElement;
  const productPriceBaseEl = document.getElementById("modal-product-price-base") as HTMLElement;
  const totalEl = document.getElementById("modal-total") as HTMLElement;
  const observacionesEl = document.getElementById("modal-observaciones") as HTMLTextAreaElement;

  const whatsappNumber = modal.dataset.whatsapp ?? "";
  const adicionalesGratisSection = modal.querySelector<HTMLElement>("#adicionales-gratuitos-section")!;
  let basePrice = 0;

  function formatCOP(n: number) {
    return `$${n.toLocaleString("es-CO")}`;
  }

  function getSelectedCombo() {
    return modal.querySelector<HTMLInputElement>('input[name="combo"]:checked') ?? null;
  }

  function recalcTotal() {
    let extra = 0;
    modal.querySelectorAll<HTMLInputElement>('input[name="adicional-pago"]:checked').forEach((cb) => {
      extra += parseInt(cb.dataset.price ?? "0", 10);
    });
    const combo = getSelectedCombo();
    if (combo?.value) extra += parseInt(combo.dataset.price ?? "0", 10);
    totalEl.textContent = formatCOP(basePrice + extra);
  }

  function openModal(name: string, price: number, category: string) {
    basePrice = price;
    productNameEl.textContent = name;
    productPriceBaseEl.textContent = formatCOP(price);

    // Adicionales gratuitos solo para hot dogs
    adicionalesGratisSection.style.display = category === "hotdogs" ? "" : "none";

    modal.querySelectorAll<HTMLInputElement>("input[type=checkbox]").forEach((cb) => {
      cb.checked = false;
    });
    // Resetear combo a "Sin combo"
    const noCombo = modal.querySelector<HTMLInputElement>('input[name="combo"][value=""]');
    if (noCombo) noCombo.checked = true;
    observacionesEl.value = "";
    recalcTotal();

    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    document.body.style.overflow = "";
  }

  function buildMessage(name: string) {
    const gratis = Array.from(
      modal.querySelectorAll<HTMLInputElement>('input[name="adicional-gratis"]:checked')
    ).map((cb) => cb.value);

    const pago = Array.from(
      modal.querySelectorAll<HTMLInputElement>('input[name="adicional-pago"]:checked')
    ).map((cb) => ({ name: cb.value, price: parseInt(cb.dataset.price ?? "0", 10) }));

    const obs = observacionesEl.value.trim();

    let msg = `Hola Solo Perros 🌭 quiero pedir:\n*${name}* — ${formatCOP(basePrice)}`;

    if (gratis.length > 0) {
      msg += `\n\n🧅 *Adicionales incluidos:*\n${gratis.map((a) => `• ${a}`).join("\n")}`;
    }

    if (pago.length > 0) {
      msg += `\n\n➕ *Adicionales extra:*\n${pago.map((a) => `• ${a.name} (+${formatCOP(a.price)})`).join("\n")}`;
    }

    const combo = getSelectedCombo();
    if (combo?.value) {
      msg += `\n\n🍟 *Combo ${combo.dataset.label}* (+${formatCOP(parseInt(combo.dataset.price ?? "0", 10))})\n   ${combo.dataset.includes}`;
    }

    if (obs) {
      msg += `\n\n📝 *Observaciones:* ${obs}`;
    }

    const total = basePrice + pago.reduce((s, a) => s + a.price, 0);
    msg += `\n\n💰 *Total: ${formatCOP(total)}*`;

    return msg;
  }

  // Abre el modal al hacer clic en cualquier botón con data-order-trigger
  document.addEventListener("click", (e) => {
    const btn = (e.target as Element).closest<HTMLElement>("[data-order-trigger]");
    if (!btn) return;
    e.preventDefault();
    openModal(btn.dataset.name ?? "", parseInt(btn.dataset.price ?? "0", 10), btn.dataset.category ?? "");
  });

  // Recalcula total al cambiar cualquier selección
  modal.addEventListener("change", (e) => {
    const name = (e.target as HTMLInputElement).name;
    if (name === "adicional-pago" || name === "combo") recalcTotal();
  });

  closeBtn.addEventListener("click", closeModal);
  backdrop.addEventListener("click", closeModal);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeModal();
  });

  function collectSelections() {
    const gratis = Array.from(
      modal.querySelectorAll<HTMLInputElement>('input[name="adicional-gratis"]:checked')
    ).map((cb) => cb.value);
    const pago = Array.from(
      modal.querySelectorAll<HTMLInputElement>('input[name="adicional-pago"]:checked')
    ).map((cb) => ({ name: cb.value, price: parseInt(cb.dataset.price ?? "0", 10) }));
    const combo = getSelectedCombo();
    const comboData = combo?.value
      ? { label: combo.dataset.label ?? "", price: parseInt(combo.dataset.price ?? "0", 10), includes: combo.dataset.includes ?? "" }
      : null;
    const obs = observacionesEl.value.trim();
    const extraPago = pago.reduce((s, a) => s + a.price, 0);
    const extraCombo = comboData?.price ?? 0;
    return { gratis, pago, comboData, obs, total: basePrice + extraPago + extraCombo };
  }

  confirmBtn.addEventListener("click", () => {
    const name = productNameEl.textContent ?? "";
    const msg = buildMessage(name);
    window.open(`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(msg)}`, "_blank", "noopener,noreferrer");
    closeModal();
  });

  addCartBtn.addEventListener("click", () => {
    const { gratis, pago, comboData, obs, total } = collectSelections();
    addItem({
      name: productNameEl.textContent ?? "",
      basePrice,
      combo: comboData,
      adicionalesGratis: gratis,
      adicionalesPago: pago,
      observaciones: obs,
      total,
    });
    closeModal();
  });
</script>
