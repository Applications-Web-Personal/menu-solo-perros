---
import { combos, formatPrice, whatsappLink } from "../data/menu";

// Ingredientes comunes a todos los combos
const commonIncludes = combos.reduce(
  (common, combo) => common.filter((item) => combo.includes.includes(item)),
  combos[0]?.includes ?? []
);

// Variante única de cada combo (lo que los diferencia)
const variants = combos.map((combo) => ({
  ...combo,
  label: combo.includes.find((inc) => !commonIncludes.includes(inc)) ?? combo.includes[0],
}));
---

<section id="combos" class="py-16 px-4 max-w-6xl mx-auto">
  <!-- Encabezado -->
  <div class="flex items-center gap-4 mb-10">
    <div class="w-1.5 h-16 rounded-full bg-[#F5A623]"></div>
    <div>
      <p class="text-gray-500 text-sm font-semibold uppercase tracking-widest">Más por menos</p>
      <h2 class="font-display text-5xl sm:text-6xl text-[#F5A623] tracking-wide leading-none">
        Combos
      </h2>
    </div>
  </div>

  <article class="bg-[#1a2340] border border-[#F5A623]/20 rounded-2xl p-6 max-w-lg">
    <!-- Ingredientes comunes -->
    <p class="text-gray-500 text-xs font-semibold uppercase tracking-widest mb-3">Todos incluyen</p>
    <div class="flex flex-wrap gap-2 mb-6">
      {
        commonIncludes.map((inc) => (
          <span class="text-sm text-gray-300 bg-[#0D1B3E] px-3 py-1 rounded-full border border-[#1B3F8B]/40">
            {inc}
          </span>
        ))
      }
    </div>

    <!-- Variantes -->
    <div class="flex flex-col divide-y divide-[#1B3F8B]/30">
      {
        variants.map((v) => {
          const msg = `Hola Solo Perros 🌭 quiero agregar un combo: *${v.label}* — ${formatPrice(v.price)}`;
          return (
            <div class="flex items-center justify-between gap-4 py-3.5 first:pt-0 last:pb-0">
              <span class="text-white text-sm">{v.label}</span>
              <div class="flex items-center gap-3 shrink-0">
                <span class="text-[#F5A623] font-bold font-display text-lg">
                  {formatPrice(v.price)}
                </span>
              </div>
            </div>
          );
        })
      }
    </div>
  </article>
</section>
