---
import { contact, whatsappLink } from "../data/menu";

const year = new Date().getFullYear();
---

<footer class="bg-brand-dark relative mt-8">
  <!-- Top gradient border -->
  <div class="absolute top-0 left-0 right-0 divider-brand"></div>

  <div class="max-w-6xl mx-auto px-4 pt-10 pb-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
      <!-- Logo + nombre -->
      <div class="flex items-center gap-3">
        <img
          src={`${import.meta.env.BASE_URL}/images/logo.png`}
          alt="Solo Perros"
          class="h-12 w-12 object-contain opacity-90"
          style="filter: drop-shadow(0 0 6px rgba(227,30,36,0.3))"
        />
        <div>
          <p class="font-display text-xl text-white tracking-wider leading-none">SOLO PERROS</p>
          <p class="font-sub font-semibold text-[#F5A623] text-xs tracking-[0.25em] uppercase mt-0.5">Comidas Rápidas</p>
        </div>
      </div>

      <!-- Links -->
      <nav class="flex flex-wrap gap-5 font-sub font-semibold text-sm text-gray-500 justify-center tracking-wide">
        <a href="#hotdogs" class="hover:text-[#F5A623] transition-colors duration-200">Hot Dogs</a>
        <a href="#hamburguesas" class="hover:text-[#F5A623] transition-colors duration-200">Hamburguesas</a>
        <a href="#salchipapas" class="hover:text-[#F5A623] transition-colors duration-200">Salchipapas</a>
        <a href="#combos" class="hover:text-[#F5A623] transition-colors duration-200">Combos</a>
        <a href="#bebidas" class="hover:text-[#F5A623] transition-colors duration-200">Bebidas</a>
        <a href="#ubicacion" class="hover:text-[#F5A623] transition-colors duration-200">Ubicación</a>
      </nav>

      <!-- WhatsApp -->
      <a
        href={whatsappLink()}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 bg-linear-to-r from-[#25D366] to-[#1aad56] hover:from-[#128C7E] hover:to-[#0e7060] text-white font-bold text-sm px-5 py-2.5 rounded-full transition-all duration-200 shadow-lg hover:shadow-[0_0_16px_rgba(37,211,102,0.3)] font-sub tracking-wide"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"></path>
          <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.553 4.116 1.522 5.847L0 24l6.338-1.501A11.95 11.95 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.01-1.373l-.36-.214-3.732.884.944-3.638-.235-.374A9.818 9.818 0 1 1 12 21.818z"></path>
        </svg>
        {contact.whatsappDisplay}
      </a>
    </div>

    <div class="mt-8 pt-6 border-t border-[#1B3F8B]/20 text-center text-gray-600 text-xs font-sub tracking-wide">
      © {year} Solo Perros — Pasto, Nariño, Colombia. Todos los derechos reservados.
    </div>
  </div>
</footer>
