---
import ProductRow from "./ProductRow.astro";
import type { MenuItem } from "../data/menu";

interface Props {
  id: string;
  title: string;
  emoji: string;
  items: MenuItem[];
  accent?: "red" | "blue" | "yellow";
  categoryImage?: string;
}

const { id, title, emoji, items, accent = "red", categoryImage } = Astro.props;
const sectionImage = categoryImage ?? items[0]?.image;

const accentMap = {
  red: { bar: "bg-[#E31E24]", text: "text-[#E31E24]" },
  blue: { bar: "bg-[#1B3F8B]", text: "text-[#2451a8]" },
  yellow: { bar: "bg-[#F5A623]", text: "text-[#F5A623]" },
};
const colors = accentMap[accent];
---

<section id={id} class="py-16 px-4 max-w-6xl mx-auto">
  <!-- Encabezado de sección -->
  <div class="flex items-center gap-4 mb-10">
    <div class={`w-1.5 h-16 rounded-full ${colors.bar}`}></div>
    <div>
      <p class="text-gray-500 text-sm font-semibold uppercase tracking-widest">Nuestra carta</p>
      <h2 class={`font-display text-5xl sm:text-6xl ${colors.text} tracking-wide leading-none`}>
        {emoji}
        {title}
      </h2>
    </div>
  </div>

  <!-- Layout: imagen izquierda + lista de productos derecha -->
  <div class="flex flex-col lg:flex-row lg:items-stretch gap-8">
    <!-- Imagen de categoría: banner 16:9 en móvil, altura dinámica en escritorio -->
    <div class="lg:w-2/5 lg:flex lg:flex-col">
      <div class="relative rounded-2xl overflow-hidden border border-[#1B3F8B]/40 aspect-video lg:aspect-auto lg:flex-1 lg:min-h-[240px]">
        <img
          src={sectionImage}
          alt={title}
          loading="lazy"
          class="absolute inset-0 w-full h-full object-cover"
        />
      </div>
    </div>

    <!-- Lista de productos -->
    <div class="lg:w-3/5 flex flex-col gap-4">
      {items.map((item) => <ProductRow item={item} />)}
    </div>
  </div>
</section>
