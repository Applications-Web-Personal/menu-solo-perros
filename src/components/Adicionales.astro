---
import { adicionales } from "../data/menu";
---

<section class="py-10 px-4 max-w-6xl mx-auto">
  <!-- Gradient border wrapper -->
  <div class="p-px rounded-2xl bg-linear-to-r from-[#F5A623]/20 via-[#1B3F8B]/20 to-[#E31E24]/20">
    <div class="bg-linear-to-br from-[#0e1830] to-[#0a1020] rounded-2xl px-6 py-6 flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <div class="shrink-0">
        <p class="font-display text-2xl text-[#F5A623] tracking-wide text-shadow-warm">⚡ Adicionales incluidos</p>
        <p class="font-sub text-gray-500 text-xs mt-0.5 tracking-wide">Sin costo extra — personaliza tu pedido</p>
      </div>
      <!-- Divider -->
      <div class="h-px w-full sm:h-10 sm:w-px bg-linear-to-r from-transparent via-[#1B3F8B]/60 to-transparent sm:bg-linear-to-b sm:mx-4"></div>
      <div class="flex flex-wrap gap-2">
        {
          adicionales.map((a) => (
            <span class="bg-[#0D1B3E] border border-[#1B3F8B]/40 hover:border-[#F5A623]/40 hover:text-[#F5A623] text-gray-300 text-sm px-3 py-1.5 rounded-full font-sub font-semibold tracking-wide transition-colors duration-200 cursor-default">
              {a}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>
