---
import { bebidas, formatPrice } from "../data/menu";
---

<section id="bebidas" class="py-16 px-4 max-w-6xl mx-auto">
  <div class="flex items-center gap-4 mb-10">
    <div class="w-1.5 h-16 rounded-full bg-[#1B3F8B]"></div>
    <div>
      <p class="text-gray-500 text-sm font-semibold uppercase tracking-widest">Para refrescarte</p>
      <h2 class="font-display text-5xl sm:text-6xl text-[#2451a8] tracking-wide leading-none">
        Bebidas
      </h2>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
    {
      bebidas.map((bebida) => (
        <div class="bg-[#1a2340] border border-[#1B3F8B]/40 rounded-2xl p-5">
          <h3 class="font-display text-2xl text-white tracking-wide mb-4">{bebida.name}</h3>
          <ul class="space-y-2.5">
            {bebida.sizes.map((s) => (
              <li class="flex items-center justify-between gap-3 border-b border-[#1B3F8B]/30 pb-2 last:border-0 last:pb-0">
                <span class="text-gray-300 text-sm">{s.label}</span>
                <div class="flex items-center gap-2.5 shrink-0">
                  <span class="text-[#F5A623] font-bold text-base">{formatPrice(s.price)}</span>
                  <button
                    type="button"
                    data-order-trigger
                    data-name={`${bebida.name} — ${s.label}`}
                    data-price={s.price}
                    data-category="bebidas"
                    class="flex items-center gap-1 bg-[#25D366] hover:bg-[#128C7E] active:bg-[#075E54] text-white text-xs font-bold px-2.5 py-1.5 rounded-lg transition-colors cursor-pointer"
                  >
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"></path>
                      <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.553 4.116 1.522 5.847L0 24l6.338-1.501A11.95 11.95 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.01-1.373l-.36-.214-3.732.884.944-3.638-.235-.374A9.818 9.818 0 1 1 12 21.818z"></path>
                    </svg>
                    Pedir
                  </button>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
