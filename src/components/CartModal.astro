---
import { contact } from "../data/menu";
---

<!-- Botón flotante carrito (oculto hasta tener items) -->
<button
  id="cart-fab"
  aria-label="Ver carrito"
  style="display:none"
  class="fixed bottom-6 left-6 z-50 flex items-center gap-2.5 bg-[#0D1B3E] border-2 border-[#1B3F8B] hover:border-[#F5A623] text-white font-bold px-4 py-3 rounded-full shadow-2xl shadow-blue-900/40 hover:scale-105 transition-all"
>
  <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2 8h14l-2-8M9 21a1 1 0 100-2 1 1 0 000 2zm10 0a1 1 0 100-2 1 1 0 000 2z"/>
  </svg>
  <span class="text-sm font-bold">Carrito</span>
  <span id="cart-fab-badge" class="bg-[#E31E24] text-white text-xs font-bold min-w-[1.25rem] h-5 px-1 rounded-full flex items-center justify-center">0</span>
</button>

<!-- Modal resumen del carrito -->
<div
  id="cart-modal"
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cart-modal-title"
  data-whatsapp={contact.whatsapp.replace("+", "")}
>
  <div id="cart-backdrop" class="absolute inset-0 bg-black/75 backdrop-blur-sm"></div>

  <div class="relative bg-[#0D1B3E] border border-[#1B3F8B]/60 rounded-2xl w-full max-w-lg max-h-[92vh] flex flex-col shadow-2xl">

    <!-- Header -->
    <div class="shrink-0 border-b border-[#1B3F8B]/40 px-5 py-4 flex items-center justify-between">
      <div>
        <p class="text-gray-500 text-xs uppercase tracking-widest mb-1">Resumen</p>
        <h2 id="cart-modal-title" class="font-display text-2xl text-white">Tu pedido</h2>
      </div>
      <button
        id="cart-close"
        aria-label="Cerrar"
        class="text-gray-400 hover:text-white transition-colors p-1.5 rounded-lg hover:bg-[#1B3F8B]/30"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Estado vacío -->
    <div id="cart-empty" class="flex-1 flex flex-col items-center justify-center py-16 gap-3">
      <span class="text-5xl">🛒</span>
      <p class="text-gray-600 text-sm">Tu carrito está vacío</p>
    </div>

    <!-- Lista de items (dinámica) -->
    <div id="cart-items-list" class="overflow-y-auto flex-1 px-5 py-5 space-y-3" style="display:none"></div>

    <!-- Footer con total y acciones -->
    <div id="cart-footer" class="shrink-0 border-t border-[#1B3F8B]/40 px-5 py-4 space-y-3" style="display:none">
      <div class="flex items-center justify-between px-1">
        <span class="text-gray-400 text-sm font-medium">Total del pedido</span>
        <span id="cart-total-display" class="text-white font-bold text-xl"></span>
      </div>
      <div class="flex gap-3">
        <button
          id="cart-clear"
          class="px-4 py-3 rounded-xl border border-[#1B3F8B]/50 text-gray-400 hover:text-white hover:border-[#E31E24]/60 transition-colors text-sm font-medium whitespace-nowrap"
        >
          Limpiar todo
        </button>
        <button
          id="cart-checkout"
          class="flex-1 flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#128C7E] active:bg-[#075E54] text-white font-bold py-3 rounded-xl transition-colors text-sm"
        >
          <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"></path>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.553 4.116 1.522 5.847L0 24l6.338-1.501A11.95 11.95 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.01-1.373l-.36-.214-3.732.884.944-3.638-.235-.374A9.818 9.818 0 1 1 12 21.818z"></path>
          </svg>
          Hacer pedido
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { getItems, removeItem, clearCart, getTotal } from "../scripts/cart";
  import type { CartItem } from "../scripts/cart";

  const fab = document.getElementById("cart-fab") as HTMLElement;
  const fabBadge = document.getElementById("cart-fab-badge") as HTMLElement;
  const modal = document.getElementById("cart-modal") as HTMLElement;
  const backdrop = document.getElementById("cart-backdrop") as HTMLElement;
  const closeBtn = document.getElementById("cart-close") as HTMLButtonElement;
  const emptyEl = document.getElementById("cart-empty") as HTMLElement;
  const itemsList = document.getElementById("cart-items-list") as HTMLElement;
  const footer = document.getElementById("cart-footer") as HTMLElement;
  const totalDisplay = document.getElementById("cart-total-display") as HTMLElement;
  const clearBtn = document.getElementById("cart-clear") as HTMLButtonElement;
  const checkoutBtn = document.getElementById("cart-checkout") as HTMLButtonElement;
  const whatsappNumber = modal.dataset.whatsapp ?? "";

  function fmt(n: number) {
    return `$${n.toLocaleString("es-CO")}`;
  }

  function renderItem(item: CartItem): string {
    const lines: string[] = [];
    if (item.combo) {
      lines.push(`🍟 Combo ${item.combo.label} <span class="text-[#F5A623]">+${fmt(item.combo.price)}</span>`);
    }
    if (item.adicionalesGratis.length > 0) {
      lines.push(`⚡ ${item.adicionalesGratis.join(", ")}`);
    }
    if (item.adicionalesPago.length > 0) {
      lines.push(`➕ ${item.adicionalesPago.map((a) => `${a.name} (+${fmt(a.price)})`).join(", ")}`);
    }
    if (item.observaciones) {
      lines.push(`📝 ${item.observaciones}`);
    }
    return `
      <div class="bg-[#1a2340] border border-[#1B3F8B]/30 rounded-xl p-4 flex gap-3">
        <div class="flex-1 min-w-0">
          <div class="flex items-start justify-between gap-2 mb-1.5">
            <span class="text-white font-bold text-base leading-tight">${item.name}</span>
            <span class="text-[#E31E24] font-bold text-sm shrink-0">${fmt(item.total)}</span>
          </div>
          ${lines.length > 0 ? `<div class="space-y-0.5 mt-1">${lines.map((l) => `<p class="text-gray-500 text-xs leading-relaxed">${l}</p>`).join("")}</div>` : ""}
        </div>
        <button
          class="cart-remove-btn shrink-0 text-gray-600 hover:text-[#E31E24] transition-colors self-start mt-0.5 p-0.5"
          data-uid="${item.uid}"
          aria-label="Eliminar"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>`;
  }

  function renderCart() {
    const items = getItems();
    const empty = items.length === 0;
    emptyEl.style.display = empty ? "" : "none";
    itemsList.style.display = empty ? "none" : "block";
    footer.style.display = empty ? "none" : "block";
    if (empty) return;
    totalDisplay.textContent = fmt(getTotal());
    itemsList.innerHTML = items.map(renderItem).join("");
    itemsList.querySelectorAll<HTMLButtonElement>(".cart-remove-btn").forEach((btn) => {
      btn.addEventListener("click", () => removeItem(btn.dataset.uid ?? ""));
    });
  }

  function buildCheckoutMessage(): string {
    const items = getItems();
    let msg = "Hola Solo Perros 🌭 quiero hacer un pedido:\n";
    items.forEach((item, i) => {
      msg += `\n*${i + 1}. ${item.name}* — ${fmt(item.basePrice)}`;
      if (item.combo) msg += `\n   🍟 Combo ${item.combo.label} (+${fmt(item.combo.price)})\n   ${item.combo.includes}`;
      if (item.adicionalesGratis.length > 0) msg += `\n   🧅 ${item.adicionalesGratis.join(", ")}`;
      if (item.adicionalesPago.length > 0) msg += `\n   ➕ ${item.adicionalesPago.map((a) => `${a.name} (+${fmt(a.price)})`).join(", ")}`;
      if (item.observaciones) msg += `\n   📝 ${item.observaciones}`;
    });
    msg += `\n\n💰 *Total: ${fmt(getTotal())}*`;
    return msg;
  }

  function openCart() {
    renderCart();
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function closeCart() {
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    document.body.style.overflow = "";
  }

  document.addEventListener("cart:update", (e: Event) => {
    const { count } = (e as CustomEvent<{ count: number }>).detail;
    fab.style.display = count > 0 ? "flex" : "none";
    fabBadge.textContent = String(count);
    if (modal.classList.contains("flex")) renderCart();
  });

  fab.addEventListener("click", openCart);
  closeBtn.addEventListener("click", closeCart);
  backdrop.addEventListener("click", closeCart);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeCart();
  });

  clearBtn.addEventListener("click", () => clearCart());

  checkoutBtn.addEventListener("click", () => {
    const msg = buildCheckoutMessage();
    window.open(`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(msg)}`, "_blank", "noopener,noreferrer");
    clearCart();
    closeCart();
  });
</script>
